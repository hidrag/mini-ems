# Mini EMS planned environment contract — no settings loaders exist yet.
# Placeholders only. Copy only each process's settings to its ignored local
# configuration; keep test and production configuration/credentials separate.
# See docs/12-environment-deployment.md for ownership and milestone scope.
APP_NAME="Mini EMS"
APP_ENV=development
APP_DEBUG=true

# Local development PostgreSQL only. Replace placeholders privately.
# Never use the More Supermarket Mega database.
DATABASE_URL=postgresql+psycopg://DEV_USER:DEV_PASSWORD@localhost:5432/DEV_DB_NAME

# Separate automated testing database/credentials; never fall back to DATABASE_URL.
# The future test runner must reject development/production targets before writes.
# TEST_DATABASE_URL=postgresql+psycopg://TEST_USER:TEST_PASSWORD@localhost:5432/TEST_DB_NAME
# Expected test database hostname; the guard validates the URL host against it.
# TEST_DATABASE_HOST=localhost

# Backend origin allowance; this example is a local value, not a production default.
FRONTEND_URL=http://localhost:5173

# Planned Phase 1 frontend build-time setting (public; no secrets).
# Base includes /api/v1; the API client must not append that prefix twice.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Planned MQTT milestone settings, loaded independently by consumer and simulator.
# These are LOCAL examples: production must use separate broker configuration,
# authentication, restricted network access and appropriate verified TLS.
# MQTT_HOST=localhost
# MQTT_PORT=1883
# MQTT_TLS_ENABLED=false
# MQTT_TLS_CA_FILE=
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CLIENT_ID=UNIQUE_CLIENT_ID_PER_PROCESS

# Planned simulator-only setting: choose/validate a positive interval at its milestone.
# SIMULATOR_PUBLISH_INTERVAL_SECONDS=SET_POSITIVE_INTERVAL

# Production: APP_ENV=production, APP_DEBUG=false, production-only DATABASE_URL
# and FRONTEND_URL, production frontend API build value, MQTT_TLS_ENABLED=true,
# approved broker TLS listener, trusted CA, unique client identities and credentials.
# Never copy development/test database connections or local MQTT security defaults.
# JWT variables remain undefined until the authentication milestone is approved.
